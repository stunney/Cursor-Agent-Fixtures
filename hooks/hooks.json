{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "node scripts/hook.mjs"
      }
    ],
    "sessionEnd": [
      {
        "command": "node scripts/hook.mjs"
      }
    ],
    "subagentStart": [
      {
        "command": "node scripts/hook.mjs",
        "failClosed": true
      }
    ],
    "subagentStop": [
      {
        "command": "node scripts/hook.mjs"
      }
    ],
    "stop": [
      {
        "command": "node scripts/hook.mjs",
        "loop_limit": 5
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node scripts/hook.mjs",
        "matcher": "UserPromptSubmit",
        "failClosed": true
      }
    ]
  }
}
